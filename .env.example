# Demo Lottery Platform — Environment Configuration
# Copy to .env and adjust. NEVER commit real secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-generate-a-long-random-string
SESSION_TTL_HOURS=12

# Database file path (relative to server/)
DATABASE_PATH=../data/demo-lottery.db

# Demo settings
INITIAL_CREDIT=10000        # virtual credit given to new members (in satang, 10000 = 100.00)
DEMO_CURRENCY=THB

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
ADMIN_MFA_REQUIRED=true
