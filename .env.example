# Demo Lottery Platform — Environment Configuration
# Copy to .env and adjust. NEVER commit real secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-generate-a-long-random-string
SESSION_TTL_HOURS=12

# Database file path (relative to server/)
DATABASE_PATH=../data/demo-lottery.db

# Demo settings
INITIAL_CREDIT=5000         # activation credit given to new members (in satang, 5000 = 50.00)
DEMO_CURRENCY=THB

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
ADMIN_MFA_REQUIRED=true

# LINE Login (ไม่บังคับ) — สร้าง channel ที่ https://developers.line.biz (ฟรี)
# Callback URL ที่ต้อง whitelist ใน LINE console: <โดเมน>/api/auth/line/callback
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CALLBACK_URL=   # เว้นว่าง = ใช้ <host>/api/auth/line/callback อัตโนมัติ

# ---------- PRODUCTION (publish to internet) ----------
# 1) ต้องรันหลัง HTTPS reverse proxy (Caddy/nginx) เสมอ — cookie Secure จะทำงาน
# 2) SESSION_SECRET = random 64 hex chars (ห้ามใช้ค่า default — production จะ throw)
# 3) TRUST_PROXY=true  — จำเป็นเมื่ออยู่หลัง nginx/caddy (ให้ rate-limit เห็น IP จริง)
#    ถ้า expose node ตรงๆ ให้ TRUST_PROXY=false (default ใน production)
# 4) OTP_DEV_ECHO=false — ปิดการส่งรหัส OTP ใน API response (default ปิดใน production
#    เพราะไม่มี SMS จริง = ใครก็ login เป็นเบอร์ไหนก็ได้ — ให้ใช้ password login แทน)
# ตัวอย่าง .env production:
#   NODE_ENV=production
#   PORT=4000
#   SESSION_SECRET=<64-hex-random>
#   TRUST_PROXY=true
#   OTP_DEV_ECHO=false
#   RATE_LIMIT_MAX=300
#   LOGIN_RATE_LIMIT_MAX=10

# ===== Payment (PromptPay + SlipOK) =====
# เบอร์/เลขบัตร PromptPay ที่รับเงิน (0xxxxxxxxx / 13 หลัก ปชช. / 15 หลัก e-Wallet)
PROMPTPAY_ID=
# SlipOK auto-verify (https://slipok.com) — เว้นว่าง = admin approve เอง
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# --- Security hardening (ฟรี) ---
# Cloudflare Turnstile (bot protection) — https://dash.cloudflare.com → Turnstile — เว้นว่าง = ปิด
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SMTP สำหรับส่งอีเมลจริง (verify email / OTP ทางอีเมล / password reset)
# ฟรี: Brevo (300/วัน), Resend, Gmail + App Password — เว้นว่าง SMTP_HOST = dev mode
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=no-reply@example.com
# เวอร์ชันข้อตกลงที่บันทึกตอนสมัคร (เปลี่ยนเมื่อแก้ Terms)
# TERMS_VERSION=2026-01
