# Demo Lottery Platform — Environment Configuration
# Copy to .env and adjust. NEVER commit real secrets.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-generate-a-long-random-string
SESSION_TTL_HOURS=12

# Database file path (relative to server/)
DATABASE_PATH=../data/demo-lottery.db

# Demo settings
INITIAL_CREDIT=5000         # activation credit given to new members (in satang, 5000 = 50.00)
DEMO_CURRENCY=THB

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
ADMIN_MFA_REQUIRED=true

# LINE Login (ไม่บังคับ) — สร้าง channel ที่ https://developers.line.biz (ฟรี)
# Callback URL ที่ต้อง whitelist ใน LINE console: <โดเมน>/api/auth/line/callback
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CALLBACK_URL=   # เว้นว่าง = ใช้ <host>/api/auth/line/callback อัตโนมัติ
