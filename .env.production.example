# ============================================================
# Production env — copy เป็น .env แล้วกรอกค่าจริง (ห้าม commit .env)
# ============================================================

NODE_ENV=production
PORT=4000

# session secret — สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
SESSION_TTL_HOURS=12

# domain สำหรับ Caddy (HTTPS อัตโนมัติ) — เช่น lottery.example.com
DOMAIN=localhost

# อยู่หลัง Caddy — บังคับใน compose แล้ว แต่ใส่ไว้กันพลาด
TRUST_PROXY=true

# demo credit เริ่มต้น (สตางค์) — production จริงควรตั้ง 0 หรือมากตามนโยบาย
INITIAL_CREDIT=0
DEMO_CURRENCY=THB

# rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# OTP — ปิด echo ใน production เสมอ (ไม่มี SMS จริง = ใครก็ login ได้)
OTP_DEV_ECHO=false
ADMIN_MFA_REQUIRED=true

# ---------- เมื่อพร้อมเสียเงินจริง (ยังไม่เปิดใช้ตอนนี้) ----------
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# SMS_PROVIDER=
# SMS_API_KEY=
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# FCM_SERVER_KEY=
